{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "windows": { "command": "${workspaceFolder}\\build.bat" },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/build.sh"] },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "windows": { "command": "${workspaceFolder}\\build.bat", "args": ["clean"] },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/build.sh", "clean"] },
            "group": "build",
            "problemMatcher": []
        }
    ]
}